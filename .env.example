# Copia este archivo como .env y rellena lo que uses.
# El camino por defecto (edge + pexels) es gratis y no necesita tarjeta.

# --- Voz ---
# edge   = voces neuronales de Microsoft. Gratis, sin clave, tiempos exactos.
# openai = mejor calidad, ~$0.015 por minuto, requiere OPENAI_API_KEY.
TTS_PROVIDER=edge
VOICE=es-MX-JorgeNeural

# Efecto de voz (gratis, solo ffmpeg). No descuadra los subtítulos.
# auto = terror en estilos de terror/suspenso, radio en scifi, nada en el resto.
# Otros: none | profunda | terror | fantasma | demonio | eco | radio
# Míralos con:  python -m crearvideos efectos
VOICE_FX=auto

# --- Imágenes ---
# pollinations = imágenes por IA a medida. Gratis, SIN clave. 9:16. Por defecto.
#                Servicio comunitario: a veces se satura y hay que reintentar.
# pexels       = fotos de stock reales. Gratis, key sin tarjeta.
# placeholder  = degradados hechos en tu PC. Gratis, sin clave, sin internet.
#                Para probar el montaje: no son fotos, son fondos de color.
# gemini       = Gemini Image (Nano Banana), IA a medida, ~$0.039/img. Requiere facturación.
# openai       = gpt-image-1-mini, IA a medida, ~$0.015 por imagen.
IMAGE_PROVIDER=pollinations

# Token de Pollinations para la ilustración buena (gptimage/flux) vía el gateway
# nuevo con crédito "pollen". Regístrate en https://enter.pollinations.ai, crea
# una API key (sk_...) y reclama pollen gratis en la sección de quests/rewards.
# Sin token, 'pollinations' funciona pero degradado a 'sana' (básico).
# Coste ínfimo: flux ~0.0018 pollen/img (0.25 pollen = ~138 imgs), gptimage aún
# menos PERO su moderación (OpenAI) rechaza terror; por eso el default es flux.
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=flux-klein

# --- Música de fondo ---
# Nivel de la música CUANDO LA VOZ CALLA (0 = muda, 1 = a tope). Puede ir alto
# porque baja sola bajo la narración (ducking). Las pistas van en assets/musica/;
# mira qué hay con:  python -m crearvideos musica
MUSIC_VOLUME=0.30

# --- Claves ---
# Gratis y sin tarjeta. Tope: 200 peticiones/hora, 20.000/mes.
# https://www.pexels.com/api/
PEXELS_API_KEY=

# OJO: la API de Gemini NO tiene tier gratis para imágenes. Con solo la clave
# responde 429; hay que HABILITAR FACTURACIÓN en el proyecto de la clave.
# Además Imagen 4 Fast ya no está para cuentas nuevas: se usa Nano Banana.
# La key se saca en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OJO: la suscripción de ChatGPT Plus / Claude Pro NO incluye acceso a la API.
# El saldo se carga aparte en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Estudio (módulo de análisis de YouTube) ---
# Modelo de texto de Pollinations para los análisis. Necesita POLLINATIONS_TOKEN;
# sin token se usa el modelo anónimo, que no ve la miniatura.
# ESTUDIO_MODEL=openai/gpt-5.4-mini

# --- YouTube (subida automática) ---
# Ruta al JSON de credenciales OAuth si no está en la raíz como client_secret.json
# YOUTUBE_CLIENT_SECRET=

# --- Laboratorio de video (lab_video/, aparte del pipeline) ---
# Usa GEMINI_API_KEY. Pon esta solo si quieres que el laboratorio gaste en otro
# proyecto de facturación. Veo y Omni NO tienen tier gratis.
# LAB_VIDEO_GEMINI_API_KEY=
# Tope de gasto por corrida en USD si no se pasa --max-usd.
# LAB_VIDEO_MAX_USD=5
